// KIVO — PostgreSQL (Supabase) schema for production deployments.
// Identical data model to prisma/schema.prisma — only the datasource differs.
// Used automatically when DATABASE_URL is a postgres:// URL (see scripts/prisma-generate.mjs).
// One-time provisioning: bun run db:push:postgres (with DATABASE_URL + DIRECT_DATABASE_URL set).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["kivo"]
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  supabaseId   String?         @unique
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  profile      Profile?
  sessions     Session[]
  resetTokens  PasswordReset[]
  posts        Post[]
  comments     Comment[]
  reactions    Reaction[]
  commentReactions CommentReaction[]
  pollVotes    PollVote[]
  savedPosts   SavedPost[]
  collections  Collection[]
  moments      Moment[]
  momentViews  MomentView[]
  momentReactions MomentReaction[]
  followers    Follow[]        @relation("following")
  following    Follow[]        @relation("follower")
  requestsSent FollowRequest[] @relation("requester")
  requestsIn   FollowRequest[] @relation("target")
  notifications Notification[] @relation("recipient")
  actorNotifications Notification[] @relation("actor")
  spaceMemberships SpaceMember[]
  ownedSpaces  Space[]

  @@schema("kivo")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@schema("kivo")
}

model PasswordReset {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@schema("kivo")
}

// ─── Profiles ────────────────────────────────────────────────────────────────

model Profile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username          String   @unique
  fullName          String
  bio               String   @default("")
  avatarUrl         String?
  coverUrl          String?
  mood              String   @default("")
  isPrivate         Boolean  @default(false)
  defaultPrivacy    String   @default("PUBLIC")
  notificationPrefs String   @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@schema("kivo")
}

// ─── Follows ─────────────────────────────────────────────────────────────────

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
  @@schema("kivo")
}

model FollowRequest {
  id          String   @id @default(cuid())
  requesterId String
  requester   User     @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)
  targetId    String
  target      User     @relation("target", fields: [targetId], references: [id], onDelete: Cascade)
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())

  @@unique([requesterId, targetId])
  @@index([targetId, status])
  @@schema("kivo")
}

// ─── Posts ───────────────────────────────────────────────────────────────────

model Post {
  id              String   @id @default(cuid())
  authorId        String
  author          User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content         String   @default("")
  privacy         String   @default("PUBLIC")
  feeling         String?
  linkUrl         String?
  linkTitle       String?
  linkDescription String?
  linkImage       String?
  spaceId         String?
  space           Space?   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  media        PostMedia[]
  reactions    Reaction[]
  comments     Comment[]
  poll         Poll?
  savedBy      SavedPost[]
  hashtags     PostHashtag[]

  @@index([authorId, createdAt])
  @@index([spaceId, createdAt])
  @@schema("kivo")
}

model PostMedia {
  id       String  @id @default(cuid())
  postId   String
  post     Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  url      String
  type     String  @default("image")
  width    Int?
  height   Int?
  position Int     @default(0)

  @@index([postId])
  @@schema("kivo")
}

model Reaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  type      String
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
  @@schema("kivo")
}

model Comment {
  id        String    @id @default(cuid())
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Comment?  @relation("Thread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("Thread")
  content   String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  reactions CommentReaction[]

  @@index([postId, createdAt])
  @@index([parentId])
  @@schema("kivo")
}

model CommentReaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  type      String
  createdAt DateTime @default(now())

  @@unique([userId, commentId])
  @@index([commentId])
  @@schema("kivo")
}

// ─── Polls (posts + moments) ─────────────────────────────────────────────────

model Poll {
  id       String       @id @default(cuid())
  postId   String?      @unique
  post     Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  momentId String?      @unique
  moment   Moment?      @relation(fields: [momentId], references: [id], onDelete: Cascade)
  options  PollOption[]
  endsAt   DateTime?

  @@schema("kivo")
}

model PollOption {
  id      String     @id @default(cuid())
  pollId  String
  poll    Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text    String
  position Int       @default(0)
  votes   PollVote[]

  @@index([pollId])
  @@schema("kivo")
}

model PollVote {
  id       String     @id @default(cuid())
  pollId   String
  optionId String
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([optionId])
  @@schema("kivo")
}

// ─── Hashtags ────────────────────────────────────────────────────────────────

model Hashtag {
  id        String        @id @default(cuid())
  tag       String        @unique
  createdAt DateTime      @default(now())
  posts     PostHashtag[]

  @@schema("kivo")
}

model PostHashtag {
  postId    String
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtagId String
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@id([postId, hashtagId])
  @@index([hashtagId])
  @@schema("kivo")
}

// ─── Saved posts + Collections ───────────────────────────────────────────────

model Collection {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime    @default(now())
  items     SavedPost[]

  @@index([userId])
  @@schema("kivo")
}

model SavedPost {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId      String
  post        Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
  collectionId String?
  collection  Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())

  @@unique([userId, postId])
  @@index([collectionId])
  @@schema("kivo")
}

// ─── Moments (24h stories) ───────────────────────────────────────────────────

model Moment {
  id         String   @id @default(cuid())
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  type       String   @default("text")
  content    String   @default("")
  mediaUrl   String?
  mediaType  String?
  background String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  views     MomentView[]
  reactions MomentReaction[]
  poll      Poll?

  @@schema("kivo")
}

model MomentView {
  id       String   @id @default(cuid())
  momentId String
  moment   Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([momentId, userId])
  @@index([momentId])
  @@schema("kivo")
}

model MomentReaction {
  id       String   @id @default(cuid())
  momentId String
  moment   Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type     String
  createdAt DateTime @default(now())

  @@unique([momentId, userId])
  @@index([momentId])
  @@schema("kivo")
}

// ─── Spaces (communities) ────────────────────────────────────────────────────

model Space {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String   @default("")
  coverUrl     String?
  avatarUrl    String?
  rules        String   @default("")
  announcement String   @default("")
  createdById  String
  createdBy    User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members SpaceMember[]
  posts   Post[]

  @@schema("kivo")
}

model SpaceMember {
  id        String   @id @default(cuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("MEMBER")
  createdAt DateTime @default(now())

  @@unique([spaceId, userId])
  @@index([userId])
  @@schema("kivo")
}

// ─── Notifications ───────────────────────────────────────────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("recipient", fields: [userId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?     @relation("actor", fields: [actorId], references: [id], onDelete: Cascade)
  type      String
  postId    String?
  commentId String?
  spaceId   String?
  spaceName String?
  preview   String?
  postPreview String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
  @@schema("kivo")
}
