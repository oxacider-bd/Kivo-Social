# ── Supabase (required) ──────────────────────────────────────────────────────
# Project URL + publishable (anon) key — Supabase Dashboard → Project Settings → API.
# The publishable key is designed to be exposed in the browser; RLS protects data.
# NEVER put the service-role key here or in any client-side code.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Database ────────────────────────────────────────────────────────────────
# Local development (SQLite):
#   DATABASE_URL=file:./db/custom.db
# Production (Supabase Postgres on Vercel) — use the POOLED connection string:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Direct (non-pooled) connection — used by `prisma db push` / migrations only:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DIRECT_DATABASE_URL=

# ── Realtime (optional, local dev only) ─────────────────────────────────────
# Set to 1 ONLY in local development to enable the socket.io fallback used by
# legacy local-only accounts (e.g. the demo user). Production realtime uses
# Supabase Realtime and must stay unset.
NEXT_PUBLIC_REALTIME_SOCKET=

# ── Internal (optional, local dev only) ─────────────────────────────────────
# Shared secret for the local realtime emitter (mini-services/realtime-service).
INTERNAL_SECRET=
REALTIME_EMIT_URL=

# ── Demo login (optional) ───────────────────────────────────────────────────
# One-click demo entry (server-side session; no credentials in the client).
# Set DEMO_LOGIN_ENABLED=false to disable it on a deployment.
DEMO_LOGIN_ENABLED=
DEMO_LOGIN_EMAIL=

# ── Site metadata (optional) ────────────────────────────────────────────────
# Canonical origin for Open Graph / metadata URLs. Falls back to localhost in dev.
NEXT_PUBLIC_APP_URL=

# ── Seed (optional) ─────────────────────────────────────────────────────────
# Password for the seeded fictional demo accounts when running `bun prisma/seed.ts`.
SEED_DEMO_PASSWORD=

# OneSignal Web Push (optional delivery layer for notifications)
# App ID is public by design (client SDK). REST API key is SERVER-ONLY:
# set it in Vercel environment variables - never in the client bundle.
NEXT_PUBLIC_ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
